# Copie este arquivo para .env.local e preencha com valores do projeto Supabase
# de DESENVOLVIMENTO. Nunca use valores de produção localmente.
# Nenhuma variável sem o prefixo NEXT_PUBLIC_ deve ser lida por código client-side.

# Público (pode chegar ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privado — somente servidor / Edge Functions
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

CREDENTIALS_ENCRYPTION_KEY=
